10 REM STARMAP for the BBC Micro (BBC BASIC II)
20 REM Original demo program for TapeRescue
30 MODE 1
40 VDU 23,1,0;0;0;0;
50 VDU 19,1,4,0,0,0
60 VDU 19,2,6,0,0,0
70 seed=RND(-42)
80 shown=0
90 PROCmilkyway(360)
100 PROCstars(240)
110 PROCmoon(1060,840,56,3)
120 PROCmoon(1084,858,50,0)
130 PROCmeteor(300,940,90)
140 PROChorizon
150 PROCconstellations
160 PROCcompass
170 PROCtitle
180 VDU 4
190 END
1000 REM Stars: dim, medium and bright
1010 DEF PROCstars(n)
1020 LOCAL i,x,y,b
1030 FOR i=1 TO n
1040 x=RND(1280)-1:y=RND(880)+120
1050 b=RND(10)
1060 IF b<6 THEN GCOL 0,1 ELSE IF b<9 THEN GCOL 0,2 ELSE GCOL 0,3
1070 PLOT 69,x,y
1080 IF b=10 THEN PROCbig(x,y)
1090 shown=shown+1
1100 NEXT
1110 ENDPROC
1200 REM A bright star drawn as a cross
1210 DEF PROCbig(x,y)
1220 MOVE x-8,y:DRAW x+8,y
1230 MOVE x,y-8:DRAW x,y+8
1240 ENDPROC
1300 REM Milky Way: a dense diagonal band
1310 DEF PROCmilkyway(n)
1320 LOCAL i,x,y
1330 GCOL 0,1
1340 FOR i=1 TO n
1350 x=RND(1280)-1
1360 y=260+x*0.5+RND(200)-100
1370 IF y<1000 THEN PLOT 69,x,y
1380 NEXT
1390 ENDPROC
1400 REM Moon: a filled disc of colour c
1410 DEF PROCmoon(cx,cy,r,c)
1420 LOCAL a,px,py,qx,qy
1430 GCOL 0,c
1440 px=cx+r:py=cy
1450 FOR a=PI/12 TO 2*PI+0.01 STEP PI/12
1460 qx=cx+r*COS(a):qy=cy+r*SIN(a)
1470 MOVE cx,cy:MOVE px,py:PLOT 85,qx,qy
1480 px=qx:py=qy
1490 NEXT
1500 ENDPROC
1600 REM Meteor with a fading tail
1610 DEF PROCmeteor(x,y,l)
1620 GCOL 0,3:MOVE x,y:DRAW x-l,y-l/2
1630 GCOL 0,2:DRAW x-l*1.8,y-l*0.9
1640 ENDPROC
1700 REM Hills along the horizon
1710 DEF PROChorizon
1720 LOCAL x,h
1730 GCOL 0,1
1740 MOVE 0,0:MOVE 0,90
1750 FOR x=32 TO 1280 STEP 32
1760 h=70+30*SIN(x/150)+RND(20)
1770 PLOT 85,x,0:PLOT 85,x,h
1780 NEXT
1790 ENDPROC
1800 DEF PROCcompass
1810 GCOL 0,3:VDU 5
1820 MOVE 16,40:PRINT "W"
1830 MOVE 624,40:PRINT "N"
1840 MOVE 1232,40:PRINT "E"
1850 VDU 4
1860 ENDPROC
1900 DEF PROCtitle
1910 COLOUR 3:PRINT TAB(16,0);"STARMAP"
1920 COLOUR 2:PRINT TAB(7,1);"The northern winter sky"
1930 COLOUR 1:PRINT TAB(9,2);shown;" stars plotted"
1940 ENDPROC
2900 REM Constellations
3000 DEF PROCconstellations
3010 LOCAL c,k,n,i,x,y,px,py,nm$
3020 RESTORE
3030 READ c
3040 FOR k=1 TO c
3050 READ nm$,n,px,py
3060 GCOL 0,3:PROCbig(px,py)
3070 VDU 5:MOVE px+16,py-16:PRINT nm$:VDU 4
3080 FOR i=2 TO n
3090 READ x,y
3100 GCOL 0,2:MOVE px,py:DRAW x,y
3110 GCOL 0,3:PROCbig(x,y)
3120 px=x:py=y
3130 NEXT
3140 NEXT
3150 ENDPROC
4000 DATA 4
4010 DATA Plough,7,560,900,640,880,700,860,770,830,780,760,880,740,900,810
4020 DATA Cassiopeia,5,140,760,200,700,250,750,300,690,360,740
4030 DATA Orion,6,840,560,900,500,940,440,980,380,1040,330,960,250
4040 DATA Cygnus,5,380,520,440,470,500,420,560,370,620,320

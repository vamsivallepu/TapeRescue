diff --git a/shared/ObservationWriter.cpp b/shared/ObservationWriter.cpp
new file mode 100644
index 0000000..6b95be0
--- /dev/null
+++ b/shared/ObservationWriter.cpp
@@ -0,0 +1,192 @@
+#include "ObservationWriter.h"
+#include "BBMBlockTypes.h"
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <system_error>
+
+//
+// Hand-written JSON emitter for schema "taperescue.observations/1".
+//
+// Per block:
+//   sample_offset  sample index of the start bit of the 0x2a sync byte
+//   time_s         the same position in seconds
+//   header_raw     filename (with its 0x00 terminator) through the next-file
+//                  address, as read; excludes the sync byte and the header CRC
+//   header         parsed fields, or null unless the header CRC is valid
+//   header_crc     {"outcome": "valid"|"invalid", "recorded": n} or {"outcome": "unreadable"}
+//   payload        payload bytes as read (hex), never zero-padded
+//   expected_len   payload length the decoder tried to read (0 if the header
+//                  could not be read and decoded)
+//   actual_len     number of payload bytes read
+//   data_crc       as header_crc, or null for a block with no payload
+//                  (the BBC format has no data CRC for an empty block)
+//
+
+ObservationWriter::ObservationWriter(const std::string& captureId, int sampleRate) :
+	mCaptureId(captureId), mSampleRate(sampleRate)
+{
+}
+
+bool ObservationWriter::validCaptureId(const std::string& id)
+{
+	if (id.size() != 64)
+		return false;
+	for (char c : id) {
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+			return false;
+	}
+	return true;
+}
+
+long long ObservationWriter::sampleOffset(const BlockObservation& obs) const
+{
+	return std::llround(obs.timeS * mSampleRate);
+}
+
+void ObservationWriter::add(const BlockObservation& obs)
+{
+	if (!obs.syncRead)
+		return;
+	mBlocks[sampleOffset(obs)] = obs;
+}
+
+std::string ObservationWriter::hex(const Bytes& bytes)
+{
+	static const char digits[] = "0123456789abcdef";
+	std::string s;
+	s.reserve(bytes.size() * 2);
+	for (Byte b : bytes) {
+		s += digits[b >> 4];
+		s += digits[b & 0xf];
+	}
+	return s;
+}
+
+// JSON string literal for raw bytes; bytes outside printable ASCII are
+// written as \u00XX (that is, the bytes are read as Latin-1).
+std::string ObservationWriter::jsonString(const Bytes& bytes)
+{
+	std::string s = "\"";
+	for (Byte b : bytes) {
+		if (b == '"' || b == '\\') {
+			s += '\\';
+			s += (char)b;
+		}
+		else if (b >= 0x20 && b < 0x7f)
+			s += (char)b;
+		else {
+			char buf[8];
+			std::snprintf(buf, sizeof(buf), "\\u%04x", (unsigned)b);
+			s += buf;
+		}
+	}
+	s += "\"";
+	return s;
+}
+
+uint32_t ObservationWriter::le(const Bytes& bytes, size_t pos, int n)
+{
+	uint32_t v = 0;
+	for (int i = n - 1; i >= 0; i--)
+		v = (v << 8) | bytes[pos + i];
+	return v;
+}
+
+std::string ObservationWriter::crcJson(bool read, Word recorded, bool matches)
+{
+	if (!read)
+		return "{\"outcome\": \"unreadable\"}";
+	std::ostringstream s;
+	s << "{\"outcome\": \"" << (matches ? "valid" : "invalid") << "\", \"recorded\": " << (unsigned)recorded << "}";
+	return s.str();
+}
+
+std::string ObservationWriter::toJson() const
+{
+	std::ostringstream s;
+	s << "{\n";
+	s << "  \"schema\": \"" << TAPERESCUE_OBS_SCHEMA << "\",\n";
+	s << "  \"capture_id\": \"" << mCaptureId << "\",\n";
+	s << "  \"decoder\": {\"name\": \"AtomTapeUtils ScanTape\", \"revision\": \"" << TAPERESCUE_ATU_REVISION
+		<< "\", \"mode\": \"bbm\"},\n";
+	s << "  \"blocks\": [";
+	bool first = true;
+	for (const auto& entry : mBlocks) {
+		const BlockObservation& obs = entry.second;
+		s << (first ? "\n" : ",\n");
+		first = false;
+
+		char time_buf[32];
+		std::snprintf(time_buf, sizeof(time_buf), "%.6f", obs.timeS);
+
+		s << "    {";
+		s << "\"sample_offset\": " << entry.first;
+		s << ", \"time_s\": " << time_buf;
+		s << ", \"header_raw\": \"" << hex(obs.headerRaw) << "\"";
+
+		// Parsed fields only when the header CRC is valid (which implies the
+		// complete header was read).
+		size_t hdr_pos = (size_t)obs.nameLen;
+		bool header_valid = obs.headerDecoded && obs.headerCrcRead && obs.headerCrcMatches
+			&& obs.headerRaw.size() >= hdr_pos + BBM_TAPE_HDR_SZ;
+		if (header_valid) {
+			Bytes name(obs.headerRaw.begin(), obs.headerRaw.begin() + hdr_pos);
+			if (!name.empty() && name.back() == 0x00)
+				name.pop_back();
+			s << ", \"header\": {\"filename\": " << jsonString(name)
+				<< ", \"load_addr\": " << le(obs.headerRaw, hdr_pos + BBM_TAPE_BLOCK_LOAD_ADR, 4)
+				<< ", \"exec_addr\": " << le(obs.headerRaw, hdr_pos + BBM_TAPE_BLOCK_EXEC_ADR, 4)
+				<< ", \"block_no\": " << le(obs.headerRaw, hdr_pos + BBM_TAPE_BLOCK_NO, 2)
+				<< ", \"block_len\": " << le(obs.headerRaw, hdr_pos + BBM_TAPE_BLOCK_LEN, 2)
+				<< ", \"flags\": " << le(obs.headerRaw, hdr_pos + BBM_TAPE_BLOCK_FLAGS, 1)
+				<< ", \"next_addr\": " << le(obs.headerRaw, hdr_pos + BBM_TAPE_BLOCK_NEXT_ADR, 4)
+				<< "}";
+		}
+		else
+			s << ", \"header\": null";
+
+		s << ", \"header_crc\": " << crcJson(obs.headerCrcRead, obs.headerCrcRecorded, obs.headerCrcMatches);
+		s << ", \"payload\": \"" << hex(obs.payload) << "\"";
+		s << ", \"expected_len\": " << obs.expectedLen;
+		s << ", \"actual_len\": " << obs.payload.size();
+		if (obs.headerDecoded && obs.expectedLen == 0)
+			s << ", \"data_crc\": null";
+		else
+			s << ", \"data_crc\": " << crcJson(obs.dataCrcRead, obs.dataCrcRecorded, obs.dataCrcMatches);
+		s << "}";
+	}
+	s << (first ? "]\n" : "\n  ]\n");
+	s << "}\n";
+	return s.str();
+}
+
+bool ObservationWriter::write(const std::string& path, std::string& error) const
+{
+	std::string tmp_path = path + ".tmp";
+	{
+		std::ofstream out(tmp_path, std::ios::binary | std::ios::trunc);
+		if (!out) {
+			error = "cannot open '" + tmp_path + "' for writing";
+			return false;
+		}
+		out << toJson();
+		out.close();
+		if (!out) {
+			error = "failed to write '" + tmp_path + "'";
+			std::error_code ec;
+			std::filesystem::remove(tmp_path, ec);
+			return false;
+		}
+	}
+	std::error_code ec;
+	std::filesystem::rename(tmp_path, path, ec);
+	if (ec) {
+		error = "cannot rename '" + tmp_path + "' to '" + path + "': " + ec.message();
+		std::filesystem::remove(tmp_path, ec);
+		return false;
+	}
+	return true;
+}
diff --git a/shared/ObservationWriter.h b/shared/ObservationWriter.h
new file mode 100644
index 0000000..ffda769
--- /dev/null
+++ b/shared/ObservationWriter.h
@@ -0,0 +1,73 @@
+#pragma once
+#ifndef OBSERVATION_WRITER_H
+#define OBSERVATION_WRITER_H
+
+//
+// TapeRescue JSON block-observation output (schema "taperescue.observations/1").
+//
+// BlockDecoder records what it actually read for each detected block (raw header
+// bytes, raw payload bytes, recorded CRCs and their outcomes) before FileDecoder
+// assembles files, so payloads are never zero-padded.
+//
+// Added by the TapeRescue patch atomtapeutils-json-observations.patch.
+//
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include "CommonTypes.h"
+
+#define TAPERESCUE_OBS_SCHEMA "taperescue.observations/1"
